# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM provider (pick one) ---------------------------------------------
# Gemini has a free tier (key from https://aistudio.google.com, no card needed).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_CONCURRENCY=1        # parallel verifier calls; keep 1 on the free tier

# Anthropic (paid). Used if LLM_PROVIDER=anthropic or no Gemini key is set.
# ANTHROPIC_API_KEY=
# GUIDE_MODEL=claude-sonnet-5-5
# GUIDE_FALLBACKS=off

# Force a provider: gemini | anthropic (default: whichever key is present)
# LLM_PROVIDER=gemini

# --- Production on Vercel (milestone 3) -----------------------------------
# BLOB_READ_WRITE_TOKEN=
