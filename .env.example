# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional: model for all pipeline stages (default: claude-sonnet-5-5)
# GUIDE_MODEL=claude-sonnet-5-5

# Optional: disable server-side refusal fallbacks
# GUIDE_FALLBACKS=off

# Optional (production on Vercel): store live-generated guides in Vercel Blob
# BLOB_READ_WRITE_TOKEN=
